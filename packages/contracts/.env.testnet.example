# =============================================================================
# TESTNET DEPLOYMENT CONFIGURATION
# =============================================================================
# Copy to .env.testnet and fill in values.
# Load with: source packages/contracts/.env.testnet
#
# EVERY KEY BELOW IS A NAME THE DEPLOY SCRIPTS ACTUALLY READ. The names are not
# cosmetic: `finalizeSetup` / `finalizeSpokeSetup` look each contract up by the
# exact env key, silently SKIP anything unset, and `verifySetup` /
# `verifySpokeSetup` then REJECT the same unset target. A misnamed variable
# therefore produces a finalize run that looks clean and a verify run that fails
# — or, worse, a contract shipped with its immediate setters still open.
#
# Hub keys and spoke keys are deliberately distinct even where they name the same
# kind of contract (FEE_MANAGER vs SPOKE_FEE_MANAGER), because hub and spoke runs
# share this one file while pointing at two different chains.
#
# Run order:
#   1. deployHub            (Base Sepolia)      -> fills in the HUB section
#   2. deploySpoke          (Optimism Sepolia)  -> fills in the SPOKE section
#   3. configure trust on the hub (setTrustedSource + setTrustedForwarder)
#   4. finalize:testnet:hub   then verify:setup:testnet:hub
#   5. finalize:testnet:spoke then verify:setup:testnet:spoke
#   6. DAO handover (propose -> wait 2 days -> activate -> accept -> verify)
# Finalizing before step 3 permanently locks out the trust wiring.

# =============================================================================
# RPC ENDPOINTS
# =============================================================================
# Public endpoints (rate limited, fine for deployment):
BASE_SEPOLIA_RPC=https://sepolia.base.org
OPTIMISM_SEPOLIA_RPC=https://sepolia.optimism.io

# For production use, get API keys from:
#   - Alchemy: https://www.alchemy.com/
#   - Infura: https://infura.io/
#   - QuickNode: https://www.quicknode.com/
# BASE_SEPOLIA_RPC=https://base-sepolia.g.alchemy.com/v2/YOUR_API_KEY
# OPTIMISM_SEPOLIA_RPC=https://opt-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# =============================================================================
# DEPLOYER WALLET
# =============================================================================
# WARNING: Never commit real private keys!
# Use a dedicated testnet wallet, NOT your mainnet wallet.
# Required for every non-local run; the Anvil fallback key only applies on
# chain 31337 / 31338.
# PRIVATE_KEY=0x...

# =============================================================================
# BLOCK EXPLORER API KEYS (for verification)
# =============================================================================
# Basescan: https://basescan.org/myapikey
BASESCAN_API_KEY=

# Optimism Etherscan: https://optimistic.etherscan.io/myapikey
OPTIMISM_ETHERSCAN_API_KEY=

# =============================================================================
# HYPERLANE MAILBOXES (inputs — required BEFORE deploying)
# =============================================================================
# Source: https://github.com/hyperlane-xyz/hyperlane-registry
# Same address on both chains due to CREATE2 deterministic deployment, but the
# scripts read two separate keys because each run only knows about its own chain.
HUB_HYPERLANE_MAILBOX=0x6966b0E55883d49BFB24539356a2f8A673E02039
SPOKE_HYPERLANE_MAILBOX=0x6966b0E55883d49BFB24539356a2f8A673E02039

# No IGP address is needed. From Hyperlane v3 the interchain gas payment is
# collected by the mailbox's own default post-dispatch hook during dispatch().

# =============================================================================
# HUB — optional inputs to deployHub
# =============================================================================
# Where protocol fees are sent (FraudRegistryHub + OperatorSubmitter).
# Defaults to the deployer EOA if unset. Post-setup this is timelocked, so
# setting it correctly up front avoids a 2-day round trip.
FEE_RECIPIENT=

# FEE_MANAGER doubles as an optional INPUT here: set it to reuse an already
# deployed hub FeeManager instead of having deployHub create one. Leave it blank
# on a fresh deployment — deployHub deploys one (wired to the chain's Chainlink
# ETH/USD feed), prints the address, and you paste it into the HUB ADDRESSES
# section below, where it is also a finalize/verify target.

# =============================================================================
# HUB ADDRESSES (outputs of deployHub — paste them back in)
# =============================================================================
# Read by: finalizeSetup, verifySetup, proposeHandover, activateHandover,
#          verifyOwnership (all via _hubTargets), and SeedOperatorData.
# ALL of these are REQUIRED by verifySetup. An unset one fails verification
# unless you opt out explicitly with SKIP_<KEY>=true (see the bottom section).
FRAUD_REGISTRY_HUB=
WALLET_REGISTRY=
TRANSACTION_REGISTRY=
CONTRACT_REGISTRY=
OPERATOR_REGISTRY=
OPERATOR_SUBMITTER=
CROSS_CHAIN_INBOX=
FEE_MANAGER=
SOULBOUND_RECEIVER=
WALLET_SOULBOUND=
SUPPORT_SOULBOUND=

# TranslationRegistry is plain Ownable2Step, not TimelockOwnable — it is NOT a
# finalize/verify target. It is only read by the DAO handover (transferred
# immediately) and by SeedLanguages.
TRANSLATION_REGISTRY=

# =============================================================================
# SPOKE — inputs to deploySpoke
# =============================================================================
# Hyperlane domain ID of the HUB chain. For Base Sepolia this equals the chain
# ID. Used for the adapter's destination allowlist and SpokeRegistry.hubChainId.
HUB_CHAIN_ID=84532

# The hub's CrossChainInbox, as BYTES32 (not a plain address) — it is read with
# vm.envBytes32 because cross-chain recipients are bytes32. Left-pad the 20-byte
# address with 24 zero bytes:
#   CROSS_CHAIN_INBOX      0x1234...cdef
#   HUB_INBOX_ADDRESS      0x0000000000000000000000001234...cdef
# Use `cast to-uint256 <address>`, which LEFT-pads. Do NOT use
# `cast to-bytes32` — it RIGHT-pads, producing a valid-looking bytes32 that
# decodes to the wrong recipient, and SpokeRegistry.hubInbox is timelocked
# after completeSetup().
HUB_INBOX_ADDRESS=

# deploySpoke also reads SOULBOUND_RECEIVER (from the HUB section above). If it
# is set, a SpokeSoulboundForwarder is deployed and authorized on the adapter;
# if blank, the cross-chain soulbound path is skipped entirely.

# Optional: a FeeManager deployed on the SPOKE chain. Leave blank for free
# registrations on this spoke. Do NOT reuse the hub's FEE_MANAGER value — it is
# a different chain, the address has no code there, and SpokeRegistry.feeManager
# is immutable, so a wrong value cannot be repointed after deployment.
SPOKE_FEE_MANAGER=

# =============================================================================
# SPOKE ADDRESSES (outputs of deploySpoke — paste them back in)
# =============================================================================
# Read by: finalizeSpokeSetup, verifySpokeSetup, handoverSpokeOwnership
#          (all via _spokeTargets). All REQUIRED by verifySpokeSetup.
HYPERLANE_ADAPTER=
SPOKE_REGISTRY=
SPOKE_SOULBOUND_FORWARDER=

# NOTE: SPOKE_FEE_MANAGER (above) is ALSO a finalize/verify target. If you
# deployed a spoke FeeManager, it must be set here or verifySpokeSetup will
# reject the run — an unfinalized FeeManager leaves setBaseFee / setFallbackPrice
# as one-transaction owner calls that can price every spoke registration out of
# reach, and SpokeRegistry.feeManager is immutable so it cannot be swapped out.
# If you did NOT deploy one, set SKIP_SPOKE_FEE_MANAGER=true below.

# =============================================================================
# DAO HANDOVER
# =============================================================================
# Required by proposeHandover / activateHandover / verifyOwnership /
# handoverSpokeOwnership. Must NOT equal the deployer EOA — the script rejects
# that as "not a handover". Run only AFTER finalize, on both chains.
DAO_OWNER=

# =============================================================================
# DELIBERATE EXCLUSIONS
# =============================================================================
# verifySetup / verifySpokeSetup reject an unset target rather than skipping it,
# because a forgotten variable is indistinguishable from a contract that was
# never locked. To exclude a contract you genuinely did not deploy, opt out by
# name so the exclusion is a recorded decision:
#   SKIP_<ENV_KEY>=true
# e.g. a hub deployment with no soulbound contracts:
#   SKIP_SOULBOUND_RECEIVER=true
#   SKIP_WALLET_SOULBOUND=true
#   SKIP_SUPPORT_SOULBOUND=true
# e.g. a spoke with no fee manager and no soulbound forwarder:
#   SKIP_SPOKE_FEE_MANAGER=true
#   SKIP_SPOKE_SOULBOUND_FORWARDER=true
