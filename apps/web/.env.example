# =============================================================================
# WEB APP ENVIRONMENT VARIABLES (Vite)
# =============================================================================
# Copy this file to .env and fill in the values
# All variables must be prefixed with VITE_ to be exposed to the browser
#
# ⚠️  EVERY VITE_* VARIABLE IS PUBLIC. Vite inlines them into the JavaScript bundle at build
# time, so anyone can read them out of the deployed site. Never put a secret here.
# VITE_ALCHEMY_API_KEY in particular is public by construction — it is protected by
# referrer/method/network restrictions in the Alchemy console, not by secrecy.
# Required settings: PRPs/deployment-security-runbook.md § "Alchemy key restrictions"
#
# If a value must stay secret it needs a server (the indexer), not a VITE_ variable.

# =============================================================================
# WEB3 CONFIGURATION
# =============================================================================

# WalletConnect Project ID (optional - get one at https://cloud.walletconnect.com)
# If not set, WalletConnect connector will not be available
VITE_WALLETCONNECT_PROJECT_ID=

# =============================================================================
# ALCHEMY API (Required for Transaction Registry)
# =============================================================================
# Get your API key at: https://dashboard.alchemy.com/apps
# Free tier: 300M compute units/month (plenty for development)
#
# The Alchemy SDK handles network routing automatically - you only need ONE key.
# The SDK constructs the correct endpoint based on the network you specify:
#   - Ethereum:  https://eth-mainnet.g.alchemy.com/v2/{key}
#   - Base:      https://base-mainnet.g.alchemy.com/v2/{key}
#   - Optimism:  https://opt-mainnet.g.alchemy.com/v2/{key}
#   - Arbitrum:  https://arb-mainnet.g.alchemy.com/v2/{key}
#   - Polygon:   https://polygon-mainnet.g.alchemy.com/v2/{key}
#
# Testnets (when VITE_TESTNET=true):
#   - Sepolia:        https://eth-sepolia.g.alchemy.com/v2/{key}
#   - Base Sepolia:   https://base-sepolia.g.alchemy.com/v2/{key}
#   - Opt Sepolia:    https://opt-sepolia.g.alchemy.com/v2/{key}
#
# IMPORTANT: Your Alchemy app must have the target networks enabled.
# Go to Dashboard > App > Networks and enable the chains you need.
VITE_ALCHEMY_API_KEY=

# =============================================================================
# INDEXER (Ponder GraphQL API)
# =============================================================================
# Origin of the Ponder indexer the dashboard, search and batch views query.
# Unset falls back to http://localhost:42069 — which in a production build means every
# visitor's browser queries their OWN machine and the whole dashboard silently returns
# nothing. apps/web/src/lib/indexer.ts warns at runtime when that happens.
#
# ⚠️  DEPLOY STEP: whatever origin you set here MUST also be added to `connect-src` in
# apps/web/vercel.json. That CSP is currently Report-Only (owner decision, audit V25), so a
# missing origin shows up as a console report today — but it becomes a hard block on the day
# the header is switched to enforcing, taking every registry query with it.
VITE_INDEXER_URL=http://localhost:42069

# =============================================================================
# ENVIRONMENT MODE
# =============================================================================

# Enable cross-chain mode (spoke + hub chains)
# Set to "true" to enable, any other value or unset to disable
VITE_CROSSCHAIN=false

# Enable testnet mode (Base Sepolia + Optimism Sepolia)
# Set to "true" to use testnets instead of local Anvil chains
VITE_TESTNET=false

# =============================================================================
# ENS CONFIGURATION
# =============================================================================

# Enable ENS name resolution (default: true)
# Set to "false" to disable ENS resolution (reduces mainnet RPC calls)
# When enabled, the app includes mainnet transport for ENS lookups
VITE_ENS_ENABLED=true

# Mainnet RPC URL for ENS resolution (optional override)
# If not set, uses VITE_ALCHEMY_API_KEY to construct Alchemy URL
# Falls back to public RPC (rate-limited) if neither is set
# ENS always requires mainnet even when app operates on testnets
VITE_MAINNET_RPC_URL=

# =============================================================================
# P2P RELAY
# =============================================================================

# Custom relay server multiaddr (optional)
# Default: uses public relay for production, local for development
VITE_RELAY_MULTIADDR=

# =============================================================================
# UI CONFIGURATION
# =============================================================================

# Homepage URL - link to the marketing landing page
# Defaults to http://localhost:3000 for local development
VITE_HOMEPAGE_URL=http://localhost:3000

# Documentation URL - link to the docs site
# Production: https://monorepo-docs-sepia.vercel.app
# Defaults to production URL; override to http://localhost:5174 for local docs dev
VITE_DOCS_URL=https://monorepo-docs-sepia.vercel.app
