{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "out/**"]
    },
    "landing#build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "forge:build": {
      "dependsOn": [],
      "outputs": ["out/**"],
      "inputs": ["src/**", "test/**", "script/**", "foundry.toml"]
    },
    "forge:test": {
      "dependsOn": ["forge:build"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      // `test/**` (not `test/**/*.{ts,tsx}`) on purpose: the previous glob matched only
      // TypeScript, so editing a JSON/CSV fixture — packages/cli/test/fixtures/*.json, which
      // includes the two keystore fixtures the credential tests decrypt — did not invalidate
      // the cache. The result was a replayed green "test" for a run that never happened.
      "inputs": ["src/**/*.{ts,tsx}", "test/**", "vitest.config.*", "vitest.setup.*"],
      "outputs": []
    },
    "@swr/contracts#test": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "test/**", "script/**", "lib/**", "foundry.toml", "remappings.txt"],
      "outputs": []
    },
    "@swr/contracts#lint": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "test/**", "script/**", "foundry.toml", ".solhint.json"]
    },
    "@swr/contracts#build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "test/**", "script/**", "lib/**", "foundry.toml", "remappings.txt"],
      "outputs": ["out/**"]
    },
    "@swr/contracts#export-abi": {
      "dependsOn": ["@swr/contracts#build"],
      "inputs": ["src/**", "foundry.toml", "remappings.txt", "scripts/export-abi.js"],
      // This task's real output is packages/abis/src/*.ts — OUTSIDE this package, so turbo
      // cannot track it (`outputs` are package-relative). With `outputs: []` a cache hit
      // replays the logs and skips the run entirely, so `pnpm export-abi` would print
      // success while writing nothing — e.g. after the generated files were reverted or
      // hand-edited. Never cache it: the task is a few hundred ms of file writes.
      "cache": false,
      "outputs": []
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "lint": {
      "dependsOn": ["^build"],
      "inputs": ["src/**/*.{ts,tsx,js,jsx}", "eslint.config.*", ".eslintrc.*"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["src/**/*.{ts,tsx}", "tsconfig.json", "tsconfig.*.json"]
    },
    "format": {
      "cache": false
    },
    "format:check": {
      "outputs": []
    },
    "clean": {
      "cache": false
    },
    "storybook": {
      "cache": false,
      "persistent": true
    },
    "build-storybook": {
      "dependsOn": ["^build"],
      "outputs": ["storybook-static/**"]
    },
    "@swr/docs#dev": {
      "cache": false,
      "persistent": true
    },
    "@swr/docs#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "@swr/docs#lint": {
      "dependsOn": ["^build"]
    },
    "@swr/docs#typecheck": {
      "dependsOn": ["^build"]
    },
    "@swr/docs#format": {
      "cache": false
    },
    "@swr/docs#format:check": {
      "outputs": []
    },
    "@swr/indexer#dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    },
    "@swr/indexer#start": {
      "dependsOn": ["^build"]
    },
    "@swr/indexer#codegen": {
      "outputs": ["src/**/*.gen.ts"],
      "dependsOn": ["^build"]
    }
  }
}
